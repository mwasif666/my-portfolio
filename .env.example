# Copy to `.env` and fill in. `.env` is gitignored.
#
# Only CLOUD_NAME is safe in the browser bundle — it appears in every delivery
# URL anyway. The key and secret are for the upload script (scripts/upload-to-
# cloudinary.mjs) and must never be imported from src/.

VITE_CLOUDINARY_CLOUD_NAME=agymx2xx

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
